{
  "manifest_version": 3,
  "name": "Street Quality Spain",
  "version": "0.4.0",
  "description": "Neighbourhood quality on Idealista listings across Spain: dirt, graffiti, crime and income, plus distance to your address.",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Street Quality Spain",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.idealista.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.idealista.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["release.json", "bcn/*.json", "spain/*.json", "madrid/*.json"],
      "matches": ["https://www.idealista.com/*"]
    }
  ]
}
