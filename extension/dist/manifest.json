{
  "manifest_version": 3,
  "name": "Street Quality Spain",
  "version": "0.2.0",
  "description": "Neighbourhood data on Idealista listings and maps: Barcelona in detail (dirt, smell, graffiti, incivism, crime), the rest of Spain by municipal crime and local income. Bundled data, no network requests.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Street Quality Spain",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.idealista.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.idealista.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["spain/*.json"],
      "matches": ["https://www.idealista.com/*"]
    }
  ]
}
