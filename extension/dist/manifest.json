{
  "manifest_version": 3,
  "name": "BCN Street Quality",
  "version": "0.1.0",
  "description": "Overlays Barcelona open data on dirt, smell, graffiti, incivism and crime on Idealista listings and maps. Bundled data, no network requests.",
  "permissions": ["storage"],
  "action": {
    "default_title": "BCN Street Quality",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.idealista.com/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.idealista.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
