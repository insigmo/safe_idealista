{
  "manifest_version": 3,
  "name": "Safe Idealista",
  "version": "0.4.2",
  "description": "Neighbourhood quality on Idealista listings across Spain: dirt, graffiti, crime and income, plus distance to your address.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Safe Idealista",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.idealista.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.idealista.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "release.json",
        "bcn/*.json",
        "spain/*.json",
        "madrid/*.json"
      ],
      "matches": [
        "https://www.idealista.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "street-quality-spain@insigmo.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "locationInfo"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
